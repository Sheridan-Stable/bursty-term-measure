    "# Extract keywords with KeyBERT\n",
    "# This vectorizer ensure that KeyBERT recognizes hyphens\n",
    "vectorizer = CountVectorizer(token_pattern=r'(?u)\\b[\\w-]+\\b')\n",
    "kw_model = KeyBERT()\n",
    "list_of_keyword = []\n",
    "for doc in docs:\n",
    "   print(\"------------------------------------------------------------------------\")\n",
    "   #doc_processed = text.replace(\"-\", \"__\")\n",
    "   keywords_and_score = kw_model.extract_keywords(doc, keyphrase_ngram_range=(1, 1), stop_words='english',top_n=25, highlight=True, vectorizer=vectorizer)\n",
    "\n",
    "   # keywords = kw_model.extract_keywords(doc, keyphrase_ngram_range=(1, 1), stop_words='english',top_n=25, highlight=True)\n",
    "\n",
    "   keywords =[]\n",
    "   for keywords_and_score in keywords_and_score:\n",
    "        keywords.append(keywords_and_score[0])\n",
    "   list_of_keyword.append(keywords) \n",
    "\n",
    "\n",
    "list_of_keyword_keybert = [item for sublist in list_of_keyword for item in sublist]\n"
   ]
